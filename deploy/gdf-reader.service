[Unit]
Description=GDF plate reader
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Desktop/GDF
Environment=GDF_DISPLAY=0
Environment=GDF_CONFIG=/home/pi/Desktop/GDF/Config.xml
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/pi/.config/gdf/runtime.env
ExecStart=/usr/bin/python3 /home/pi/Desktop/GDF/MainPlateGSF.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
