# Copy locally to /home/pi/.config/gdf/runtime.env; chmod 600.
# Leave optional integrations blank until configured. Never commit real values.
GDF_SMTP_HOST=smtp-mail.outlook.com
GDF_SMTP_USER=
GDF_SMTP_PASSWORD=
GDF_SMTP_TO=
GDF_TELEGRAM_TOKEN=
GDF_TELEGRAM_CHAT=
GDF_IMAGE_INFO_URL=
GDF_DEVICE_INFO_URL=
GDF_ALLOW_REBOOT=0
# Public dashboard receiver; only the sender holds the write token.
GDF_HEALTH_URL=
GDF_HEALTH_TOKEN=
GDF_HEALTH_LABEL=

# Local dashboard: http://127.0.0.1:8765/ (only this Raspberry).
GDF_DASHBOARD=1
